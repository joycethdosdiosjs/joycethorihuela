    },
    {
      "cell_type": "code",
      "source": [
        "n=len(A)\n",
        "\n",
        "for i in range (n):\n",
        "  minimo= i\n",
        "\n",
        "  for j in range (i+1, n):\n",
        "    if A[j] < A[minimo]:\n",
        "      minimo = j\n",
        "\n",
        "  A[i], A[minimo] = A[minimo], A[i]\n",
        "\n",
        "print(\"Lista ordenada:\", A)"
      ],
